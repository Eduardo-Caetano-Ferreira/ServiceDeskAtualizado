{
  "version": 2,
  "functions": {
    "api/extract-technicians.ts": {
      "maxDuration": 60
    },
    "api/test-gemini.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/extract-technicians",
      "destination": "/api/extract-technicians"
    },
    {
      "source": "/api/test-gemini",
      "destination": "/api/test-gemini"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
