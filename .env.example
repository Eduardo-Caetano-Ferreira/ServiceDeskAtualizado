# Chave da API do Claude (console.anthropic.com -> API Keys)
ANTHROPIC_API_KEY=
# Opcional: segunda chave usada como failover se a primeira falhar (401/403/cota)
ANTHROPIC_API_KEY_2=
# Opcional: cadeia de modelos separada por vírgula, em ordem de prioridade.
# Sem isso, usa a lista padrão de api/_lib/claude.ts
CLAUDE_MODELS=
PORT=3000
